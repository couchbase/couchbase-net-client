<Project>
  <!-- Inherit the repository-wide build settings. Because this file exists,
       MSBuild stops walking up the tree, so we import the root explicitly. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Everything under src/ ships, so a warning here is a build failure. Couchbase.csproj has
         worked this way for years; this extends it to the other shipped packages, which until now
         took analyzer and compiler findings as warnings nobody read.

         Scoped to src/ rather than the repo root on purpose: the test projects still have 28
         net48-only warning sites, and net48 builds on Windows alone, so clearing them is a
         separate job with a CI round trip per attempt. See NCBC-4252. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
