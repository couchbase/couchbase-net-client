<Project InitialTargets="_CouchbaseNetClientTfmSupportWarning">
  <!--
    Warns projects that target a .NET (Core) version older than net10.0. Microsoft ended support
    for .NET 8 and .NET 9 on 2026-11-10. CouchbaseNetClient 3.12.0 removes the net8.0 build,
    and these projects then use the netstandard2.1 build. Same opt-out property as the
    Microsoft packages use.
  -->
  <Target Name="_CouchbaseNetClientTfmSupportWarning"
          Condition="'$(SuppressTfmSupportBuildWarnings)' != 'true'
                     And '$(TargetFrameworkIdentifier)' == '.NETCoreApp'
                     And '$(TargetFramework)' != ''
                     And !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <Warning Code="CBNET0001"
             Text="CouchbaseNetClient: $(TargetFramework) is out of Microsoft support. CouchbaseNetClient 3.12.0 removes its net8.0 build, and projects that target a framework older than net10.0 will then use its netstandard2.1 build. Move to net10.0 or later. To hide this warning, set &lt;SuppressTfmSupportBuildWarnings&gt;true&lt;/SuppressTfmSupportBuildWarnings&gt; in the project file." />
  </Target>
</Project>
